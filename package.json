{
  "name": "theysay",
  "productName": "TheySay",
  "appId": "com.laike9m.theysay",
  "desktopName": "theysay.desktop",
  "version": "1.0.0",
  "description": "Twitter / X & Discord dynamic parallel dashboard",
  "main": "main.js",
  "scripts": {
    "build:ui": "node scripts/build-ui.js",
    "start": "node scripts/build-ui.js && node scripts/brand-app.js && electron .",
    "postinstall": "node scripts/build-ui.js && node scripts/brand-app.js",
    "test": "node scripts/build-ui.js && playwright test",
    "dist:mac": "node scripts/build-ui.js && electron-builder --mac --arm64 --publish never",
    "dist:mac:quick": "node scripts/build-ui.js && THEYSAY_SKIP_NOTARIZE=1 electron-builder --mac --arm64 --publish never",
    "dist:win": "node scripts/build-ui.js && electron-builder --win --x64 --publish never",
    "dist:linux": "node scripts/build-ui.js && electron-builder --linux --x64 --publish never",
    "dist:all": "npm run dist:mac && npm run dist:win && npm run dist:linux",
    "dist:all:quick": "npm run dist:mac:quick && npm run dist:win && npm run dist:linux"
  },
  "keywords": [],
  "author": "laike9m <laike9m@gmail.com>",
  "homepage": "https://github.com/laike9m/TheySay",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.laike9m.theysay",
    "productName": "TheySay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "src/**/*",
      "data/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "data/**",
      "src/ui/tweet-embed-frame.html",
      "src/data/discord-preload.js"
    ],
    "afterAllArtifactBuild": "scripts/notarize-mac.js",
    "publish": [
      {
        "provider": "github",
        "owner": "laike9m",
        "repo": "TheySay"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "assets/icon.png",
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network",
      "maintainer": "laike9m <laike9m@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.25.5"
  },
  "dependencies": {
    "@mantine/core": "^8.1.1",
    "@mantine/hooks": "^8.1.1",
    "@mantine/notifications": "^8.1.1",
    "@tabler/icons-react": "^3.34.0",
    "an-array-of-english-words": "^2.0.0",
    "colord": "^2.10.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.11",
    "gridstack": "^13.2.0",
    "link-preview-js": "^3.1.0",
    "linkify-it": "^4.0.0",
    "lru-cache": "^10.4.3",
    "normalize-url": "^6.1.0",
    "p-limit": "^3.1.0",
    "p-queue": "^6.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "semver": "^7.8.5",
    "tlds": "^1.259.0"
  }
}
