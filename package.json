{
  "name": "theysay",
  "productName": "TheySay",
  "appId": "com.laike9m.theysay",
  "desktopName": "theysay.desktop",
  "version": "1.0.0",
  "description": "Twitter / X & Discord dynamic parallel dashboard",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/brand-app.js && electron .",
    "postinstall": "node scripts/brand-app.js",
    "test": "playwright test",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:mac:quick": "THEYSAY_SKIP_NOTARIZE=1 electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "dist:all": "npm run dist:mac && npm run dist:win && npm run dist:linux",
    "dist:all:quick": "npm run dist:mac:quick && npm run dist:win && npm run dist:linux"
  },
  "keywords": [],
  "author": "laike9m <laike9m@gmail.com>",
  "homepage": "https://github.com/laike9m/TheySay",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.laike9m.theysay",
    "productName": "TheySay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "src/**/*",
      "data/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "data/**",
      "src/ui/tweet-embed-frame.html"
    ],
    "afterAllArtifactBuild": "scripts/notarize-mac.js",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network",
      "maintainer": "laike9m <laike9m@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.17.0"
  },
  "dependencies": {
    "gridstack": "^13.2.0"
  }
}
